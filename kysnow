#!/usr/bin/env python3
import os, sys, time, shutil, subprocess, termios, tty, select
import cv2
import numpy as np

braille = "--letters" not in sys.argv

here = os.path.dirname(os.path.realpath(__file__))
video = next((p for p in (os.path.join(d, "video.mp4") for d in (here, "/usr/share/kysnow", "/usr/local/share/kysnow")) if os.path.isfile(p)), None)
if not video:
    sys.exit("kysnow: video.mp4 not found")

RAMP = np.array(list(" .'`^\",:;Il!i~+_-?][}{1)(|\\/tfjrxnuvczXYUJCLQ0OZmwqpdbkhao*#MW&8%B@$"))
PREFIX = np.array([
    "\x1b[38;2;%d;%d;%dm" % (((i >> 10) & 31) * 8 + 4, ((i >> 5) & 31) * 8 + 4, (i & 31) * 8 + 4)
    for i in range(32768)
])
BRAILLE_CHARS = np.array([chr(0x2800 + i) for i in range(256)])
BAYER = (np.array([[0, 4], [6, 2], [1, 5], [7, 3]]) + 0.5) / 8 * 255
BITS = np.array([[0x01, 0x08], [0x02, 0x10], [0x04, 0x20], [0x40, 0x80]])

cap = cv2.VideoCapture(video)
fps = cap.get(cv2.CAP_PROP_FPS) or 30
vw = cap.get(cv2.CAP_PROP_FRAME_WIDTH)
vh = cap.get(cv2.CAP_PROP_FRAME_HEIGHT)

cols, rows = shutil.get_terminal_size()
rows -= 1
w = cols
h = int(w * vh / vw * 0.5)
if h > rows:
    h = rows
    w = int(h * 2 * vw / vh)

THR = np.tile(BAYER, (h, w))
BITS_T = np.tile(BITS, (h, w))


def colorize(chars, small):
    q = (small >> 3).astype(np.uint16)
    code = (q[:, :, 2] << 10) | (q[:, :, 1] << 5) | q[:, :, 0]
    same = np.zeros(code.shape, dtype=bool)
    same[:, 1:] = code[:, 1:] == code[:, :-1]
    cells = np.where(same, chars, np.char.add(PREFIX[code], chars))
    return "\n".join("".join(r) for r in cells) + "\x1b[0m"


def render(frame):
    small = cv2.resize(frame, (w, h), interpolation=cv2.INTER_AREA)
    if braille:
        big = cv2.resize(frame, (w * 2, h * 4), interpolation=cv2.INTER_AREA)
        gray = cv2.cvtColor(big, cv2.COLOR_BGR2GRAY)
        bits = ((gray > THR) * BITS_T).reshape(h, 4, w, 2).sum(axis=(1, 3))
        chars = BRAILLE_CHARS[bits]
        mx = small.max(axis=2, keepdims=True).clip(1, None).astype(np.uint16)
        small = (small.astype(np.uint16) * 255 // mx).astype(np.uint8)
    else:
        gray = cv2.cvtColor(small, cv2.COLOR_BGR2GRAY)
        chars = RAMP[gray.astype(np.uint16) * (len(RAMP) - 1) // 255]
    return colorize(chars, small)


audio = None
try:
    audio = subprocess.Popen(["mpv", "--no-video", "--really-quiet", "--loop=inf", video],
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
except FileNotFoundError:
    pass

fd = sys.stdin.fileno()
old_term = termios.tcgetattr(fd)
tty.setcbreak(fd)

sys.stdout.write("\x1b[?25l\x1b[2J")
try:
    start = time.perf_counter()
    frame_no = 0
    while True:
        if select.select([sys.stdin], [], [], 0)[0]:
            keys = os.read(fd, 32).decode(errors="ignore")
            if "q" in keys:
                break
            if "1" in keys:
                braille = not braille
                sys.stdout.write("\x1b[2J")
        target = int((time.perf_counter() - start) * fps)
        if target < frame_no:
            time.sleep(0.001)
            continue
        while frame_no < target:
            cap.grab()
            frame_no += 1
        ok, frame = cap.read()
        frame_no += 1
        if not ok:
            cap.set(cv2.CAP_PROP_POS_FRAMES, 0)
            frame_no = 0
            start = time.perf_counter()
            continue
        sys.stdout.write("\x1b[H" + render(frame))
        sys.stdout.flush()
except KeyboardInterrupt:
    pass
finally:
    if audio:
        audio.terminate()
    termios.tcsetattr(fd, termios.TCSADRAIN, old_term)
    sys.stdout.write("\x1b[?25h\x1b[0m\n")
